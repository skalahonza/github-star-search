@inherits LayoutComponentBase

<MudThemeProvider Theme="@_theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="app-shell">
    <header class="appbar">
        <div class="appbar-logo" aria-hidden="true">
            <img src="icon-192.png" alt="" width="38" height="38" />
        </div>
        <span class="appbar-title">Github Star Search</span>
        <div class="appbar-spacer"></div>
    </header>

    <main>
        @Body
    </main>
</div>

@code {
    private readonly MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#7e6fff",
            Surface = "#16162a",
            Background = "#08080f",
            BackgroundGray = "#0c0c18",
            AppbarText = "#c8c6d8",
            AppbarBackground = "rgba(8,8,15,0.75)",
            DrawerBackground = "#08080f",
            ActionDefault = "#8886a0",
            TextPrimary = "#c8c6d8",
            TextSecondary = "#8886a0",
            Info = "#4a86ff",
            Success = "#3dcb6c",
            Warning = "#ffb545",
            Error = "#ff3f5f",
            LinesDefault = "rgba(126,111,255,0.15)",
            Divider = "rgba(126,111,255,0.12)",
        },
        LayoutProperties = new LayoutProperties()
    };
}
